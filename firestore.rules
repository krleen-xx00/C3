rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate document IDs
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    // Safety flags collection for C3 Student Safety Flagging system
    // Managed exclusively through secure authenticated backend proxy
    match /safety_flags/{flagId} {
      allow read: if true;
      allow write: if isValidId(flagId);
    }

    // Counselor audit logs collection
    match /counselor_audit_logs/{logId} {
      allow read: if true;
      allow write: if isValidId(logId);
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
